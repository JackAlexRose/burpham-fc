---
import Layout from "../layouts/Layout.astro";
import { MainNav } from "../components/MainNav";
import { getEmDashCollection } from "emdash";

const { entries: committeeMembers } = await getEmDashCollection("committee_members");
const { entries: sponsors } = await getEmDashCollection("sponsors");
---

<Layout title="About Us" description="Learn more about Burpham Football Club and our history.">
	<MainNav client:only="react" slot="nav" />

	<div class="container mx-auto p-4 min-h-screen">
		<h1 class="mb-8 text-3xl font-bold text-white">About Burpham Football Club</h1>

		<div class="mb-8">
			<p class="mb-4 text-zinc-300">
				Burpham Football Club is a community football club based in Burpham, Guildford.
				We welcome players of all abilities and are committed to providing a friendly
				and competitive environment for everyone.
			</p>
		</div>

		<div class="mb-8">
			<h2 class="mb-4 text-2xl font-semibold text-white">Committee Members</h2>
			<div class="grid gap-6 md:grid-cols-2">
				{committeeMembers.map((member) => (
					<div class="rounded-lg border bg-zinc-900/50 text-card-foreground shadow-sm">
						<div class="flex flex-col space-y-1.5 p-6">
							<h3 class="text-2xl font-semibold leading-none tracking-tight text-white">
								{member.data.role || member.data.title}
							</h3>
						</div>
						<div class="p-6 pt-0">
							<p class="text-xl font-semibold text-white">{member.data.name}</p>
							<p class="mb-4 text-zinc-400 mt-2">{member.data.description}</p>
							{member.data.photo?.src && (
								<div class="flex space-x-4 items-center justify-center">
									<img
										src={member.data.photo.src}
										alt={member.data.name || "Committee member"}
										width="200"
										height="200"
										class="rounded-full"
									/>
								</div>
							)}
						</div>
					</div>
				))}
			</div>
		</div>

		<div class="mb-8">
			<h2 class="mb-4 text-2xl font-semibold text-white">Connect with Us</h2>
			<div class="flex space-x-4">
				<a
					href="https://www.instagram.com/burphamfc/"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium h-10 px-4 py-2 bg-zinc-200 hover:bg-burpham-green transition-colors"
				>
					Instagram
				</a>
				<a
					href="https://www.youtube.com/@BurphamFC"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium h-10 px-4 py-2 bg-zinc-200 hover:bg-burpham-yellow transition-colors"
				>
					YouTube
				</a>
			</div>
		</div>

		<div>
			<h2 class="mb-4 text-2xl font-semibold text-white">Our Sponsors</h2>
			<div class="grid gap-6 md:grid-cols-2">
				{sponsors.map((sponsor) => (
					<div class="rounded-lg border bg-zinc-900/50 text-card-foreground shadow-sm">
						<div class="flex flex-col space-y-1.5 p-6">
							<h3 class="text-2xl font-semibold leading-none tracking-tight text-white">
								{sponsor.data.title}
							</h3>
						</div>
						<div class="p-6 pt-0">
							<p class="text-xl font-semibold text-white">{sponsor.data.subtitle}</p>
							<p class="mb-4 text-zinc-400 mt-2">{sponsor.data.description}</p>
							{sponsor.data.website_url && (
								<a
									href={sponsor.data.website_url}
									target="_blank"
									rel="noopener noreferrer"
									class="text-white underline underline-offset-4 hover:text-burpham-yellow"
								>
									Visit Website
								</a>
							)}
						</div>
					</div>
				))}
			</div>
		</div>
	</div>
</Layout>
