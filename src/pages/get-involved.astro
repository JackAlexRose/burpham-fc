---
import Layout from "../layouts/Layout.astro";
import { MainNav } from "../components/MainNav";
import { getEmDashEntry } from "emdash";

const { entry: page } = await getEmDashEntry("pages", "get-involved");
const title = page?.data?.title ?? "Get Stuck In";
---

<Layout title="Get Involved" description="Learn how you can get involved with Burpham Football Club.">
	<MainNav client:only="react" slot="nav" />

	<div class="container mx-auto p-4 min-h-screen">
		<h1 class="mb-8 text-3xl font-bold text-white">{title}</h1>
		<div class="mb-8 text-zinc-300 whitespace-pre-wrap">
			Whether you're an experienced player or a complete beginner, we have a place for you at our club. Get in touch via our social media channels to find out more about training sessions and match days.
		</div>

		<div class="mb-8">
			<h2 class="mb-4 text-2xl font-semibold text-white">Connect with Us</h2>
			<div class="flex space-x-4">
				<a
					href="https://www.instagram.com/burphamfc/"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium h-10 px-4 py-2 bg-zinc-200 hover:bg-burpham-green transition-colors"
				>
					Instagram
				</a>
				<a
					href="https://www.youtube.com/@BurphamFC"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium h-10 px-4 py-2 bg-zinc-200 hover:bg-burpham-yellow transition-colors"
				>
					YouTube
				</a>
			</div>
		</div>
	</div>
</Layout>
